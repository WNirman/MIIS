{
  "appId": "lk.miis.fisherman",
  "appName": "MIIS Sea Reporter",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "Geolocation": {
      "enableHighAccuracy": true
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#0A192F",
      "showSpinner": false
    }
  }
}
